{
  "name": "title-h1-filename-sync",
  "version": "1.4.0",
  "description": "Synchronizes YAML frontmatter title with the first H1 heading bidirectionally, and updates the filename to match.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.11",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "^5.3.3"
  }
}
